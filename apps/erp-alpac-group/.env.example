# Copiar a .env o .env.local y completar valores reales.
VITE_API_URL=
VITE_API_KEY=

# --- Desarrollo: login mock en /auth ---
# Por defecto el botón "Entrar sin servidor (mock)" está visible con `pnpm dev`.
# Para ocultarlo y usar solo login real:
# VITE_DEV_MOCK_AUTH=false

# Opcionales (valores por defecto si no se definen):
# VITE_DEV_MOCK_COMPANY_ALIAS=alpac
# VITE_DEV_MOCK_COMPANY_ID=00000000-0000-0000-0000-000000000001
# NMI-43GW = payroll (sidebar colaboradores) | GES-M86T = work-management (perfil)
# VITE_DEV_MOCK_MODULE_CODE=NMI-43GW
# VITE_DEV_MOCK_ROLE=Administrator
