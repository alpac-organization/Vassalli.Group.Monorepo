---
import Header from "@components/astro/header.astro";
import Footer from "@components/astro/footer.astro";

const { title } = Astro.props;
---

<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
   </head>
   <body class="min-h-screen grid grid-rows-[auto_1fr_auto] bg-[#FAFAFA] text-neutral-900 dark:bg-[#363a45] dark:text-white transition-colors duration-300">
      <Header />
      <main class="w-full max-w-300 mx-auto px-6 py-6 md:py-8 min-h-0">
         <h1>{title}</h1>
         <slot />
      </main>
      <Footer />
   </body>
</html>
